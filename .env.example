# MongoDB Atlas connection string
MONGODB_URI=

# Admin login. Generate the hash with: npm run hash-password -- "YourStrongPassword"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random string, minimum 32 characters (e.g. openssl rand -hex 32)
SESSION_SECRET=

# Public site URL, used for canonical URLs, OG tags and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Optional SMTP for inquiry email notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=
